/* Placeholder local jQuery fallback.
   Для полноценной работы jQuery используйте CDN или загрузите реальный файл jquery.min.js.
*/
window.jQuery = window.$ = function(selector) {
    return document.querySelectorAll(selector);
};
window.jQuery.ready = function(callback) {
    if (document.readyState !== 'loading') {
        callback();
    } else {
        document.addEventListener('DOMContentLoaded', callback);
    }
};
window.jQuery.ajax = function(options) {
    var xhr = new XMLHttpRequest();
    xhr.open(options.type || 'GET', options.url, true);
    if (options.headers) {
        for (var key in options.headers) {
            xhr.setRequestHeader(key, options.headers[key]);
        }
    }
    xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
            if (options.success) options.success(xhr.responseText);
        } else if (options.error) {
            options.error(xhr, xhr.status, xhr.statusText);
        }
    };
    xhr.onerror = function() {
        if (options.error) options.error(xhr, xhr.status, xhr.statusText);
    };
    xhr.send(options.data || null);
};
