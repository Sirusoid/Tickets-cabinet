# Configure these variables in Plesk/Apache/PHP-FPM, never commit real values.
ZHASSAHNA_APP_ENV=production
ZHASSAHNA_DB_HOST=localhost
ZHASSAHNA_DB_PORT=3306
ZHASSAHNA_DB_NAME=your_database_name
ZHASSAHNA_DB_USER=your_database_user
ZHASSAHNA_DB_PASS=your_database_password
ZHASSAHNA_TICKET_PUBLIC_SECRET=generate-a-long-random-secret
# Optional one-time CLI bootstrap utility; unset after use.
ZHASSAHNA_BOOTSTRAP_ADMIN_USER=admin
ZHASSAHNA_BOOTSTRAP_ADMIN_PASSWORD=one-time-random-password